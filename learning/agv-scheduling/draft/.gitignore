# uv / Python 虚拟环境（由 uv sync 本地生成，不提交）
.venv/

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class

# 测试与覆盖率缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter Notebook 目录级缓存（.ipynb 文件本身仍提交）
.ipynb_checkpoints/

# 类型检查缓存
.mypy_cache/
.ruff_cache/

# 本地数据/输出（按需）
data/
*.log

# 编辑器临时文件
.DS_Store
